[sub_resource type="GDScript" id="GDScript_eqxsl"]
script/source = "extends Area2D
@onready var floating_ground: AnimatableBody2D = $\"../FloatingGround\"


func _on_body_entered(body: Node2D) -> void:
	if body.name == \"Player Solo\":
		print(\"Sound effects\")
		floating_ground.show()
"

